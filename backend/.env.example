# WorkPulse backend configuration. Copy to .env and adjust.

PORT=4000
# Demo default only. Generate a strong secret before any real deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=workpulse-demo-secret-change-me
NODE_ENV=development

# When DATABASE_URL is set, WorkPulse uses your PostgreSQL instance
# (e.g. via docker compose) instead of the embedded database.
# DATABASE_URL=postgresql://workpulse:workpulse@localhost:5433/workpulse?schema=public

# Embedded PostgreSQL (used automatically when DATABASE_URL is unset).
EMBEDDED_PG_PORT=5433

# Automatically migrate + seed on boot when the database is empty.
AUTO_SETUP=1

# Pin the demo "today" to the canonical seed day (2026-09-21) so the seeded
# registers, dashboard counts and demo feed stay authoritative regardless of
# when the app is run. Remove to follow the real wall-clock day.
DEMO_TODAY_YMD=2026-09-21

FRONTEND_ORIGIN=http://localhost:5173